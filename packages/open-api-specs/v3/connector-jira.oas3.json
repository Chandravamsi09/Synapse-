    "/jiraprojects": {
      "get": {
        "summary": "List all JiraProject instances",
        "tags": [
          "Jira Software Connector"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
