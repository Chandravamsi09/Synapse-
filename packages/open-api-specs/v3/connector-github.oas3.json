    "title": "Synapse - GitHub Integration Connector API",
    "version": "1.0.0",
    "description": "Enterprise REST API specification for GitHub Integration Connector module in Synapse Platform."
  },
  "servers": [
    {
      "url": "https://gateway.synapse.dev/v1/github",
      "description": "Production Gateway"
    },
    {
      "url": "http://localhost:4000/v1/github",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/githubrepos": {
      "get": {
        "summary": "List all GithubRepo instances",
        "tags": [
          "GitHub Integration Connector"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of GithubRepo resources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GithubRepo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access"
          }
        }
      },
      "post": {
        "summary": "Create a new GithubRepo",
        "tags": [
          "GitHub Integration Connector"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGithubRepoRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "GithubRepo created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GithubRepo"
                }
              }
            }
          }
        }
      }
    },
