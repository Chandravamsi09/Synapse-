{
  "id": "datadog",
  "name": "Datadog",
  "version": "2.4.0",
  "description": "Production-ready enterprise connector for Datadog. Supports automated webhook sync, bidirectional OAuth2, event dispatching, and rate limit throttling.",
  "category": "Enterprise Integration",
  "authentication": {
    "types": [
      "OAUTH2",
      "API_KEY",
      "BEARER_TOKEN"
    ],
    "tokenUrl": "https://auth.datadog.com/oauth/v2/token",
    "authorizationUrl": "https://auth.datadog.com/oauth/v2/authorize",
    "scopes": [
      "read",
      "write",
      "admin",
      "webhooks"
    ]
  },
  "endpoints": [
    {
      "name": "List Resources",
      "path": "/datadog/v1/resources",
      "method": "GET",
      "rateLimit": 120
    },
    {
      "name": "Create Resource",
      "path": "/datadog/v1/resources",
      "method": "POST",
      "rateLimit": 60
    },
    {
      "name": "Get Resource Details",
      "path": "/datadog/v1/resources/:id",
      "method": "GET",
      "rateLimit": 300
    },
    {
      "name": "Update Resource",
      "path": "/datadog/v1/resources/:id",
      "method": "PUT",
      "rateLimit": 60
    },
    {
      "name": "Delete Resource",
      "path": "/datadog/v1/resources/:id",
      "method": "DELETE",
      "rateLimit": 30
    },
    {
      "name": "Subscribe Webhooks",
      "path": "/datadog/v1/webhooks",
      "method": "POST",
      "rateLimit": 20
    },
    {
      "name": "Verify Connection Health",
      "path": "/datadog/v1/health",
      "method": "GET",
      "rateLimit": 600
    }
  ],
  "eventTriggers": [
    {
      "event": "datadog.created",
      "summary": "Triggered when an entity is created in Datadog"
    },
    {
      "event": "datadog.updated",
      "summary": "Triggered when an entity is updated in Datadog"
    },
    {
      "event": "datadog.deleted",
      "summary": "Triggered when an entity is deleted in Datadog"
    },
    {
      "event": "datadog.sync_failed",
      "summary": "Triggered when real-time synchronization encounters errors"
    }
  ],
  "rateLimits": {
    "tierStandard": {
      "requestsPerMinute": 120,
      "burst": 30
    },
    "tierEnterprise": {
      "requestsPerMinute": 2400,
      "burst": 500
    }
  }
}
