{
  "id": "trello",
  "name": "Trello",
  "version": "2.4.0",
  "description": "Production-ready enterprise connector for Trello. Supports automated webhook sync, bidirectional OAuth2, event dispatching, and rate limit throttling.",
  "category": "Enterprise Integration",
  "authentication": {
    "types": [
      "OAUTH2",
      "API_KEY",
      "BEARER_TOKEN"
    ],
    "tokenUrl": "https://auth.trello.com/oauth/v2/token",
    "authorizationUrl": "https://auth.trello.com/oauth/v2/authorize",
    "scopes": [
      "read",
      "write",
      "admin",
      "webhooks"
    ]
  },
  "endpoints": [
    {
      "name": "List Resources",
      "path": "/trello/v1/resources",
      "method": "GET",
      "rateLimit": 120
    },
    {
      "name": "Create Resource",
      "path": "/trello/v1/resources",
      "method": "POST",
      "rateLimit": 60
    },
    {
      "name": "Get Resource Details",
      "path": "/trello/v1/resources/:id",
      "method": "GET",
      "rateLimit": 300
    },
    {
      "name": "Update Resource",
      "path": "/trello/v1/resources/:id",
      "method": "PUT",
      "rateLimit": 60
    },
    {
      "name": "Delete Resource",
      "path": "/trello/v1/resources/:id",
      "method": "DELETE",
      "rateLimit": 30
    },
    {
      "name": "Subscribe Webhooks",
      "path": "/trello/v1/webhooks",
      "method": "POST",
      "rateLimit": 20
    },
    {
      "name": "Verify Connection Health",
      "path": "/trello/v1/health",
      "method": "GET",
      "rateLimit": 600
    }
  ],
  "eventTriggers": [
    {
      "event": "trello.created",
      "summary": "Triggered when an entity is created in Trello"
    },
    {
      "event": "trello.updated",
      "summary": "Triggered when an entity is updated in Trello"
    },
    {
      "event": "trello.deleted",
      "summary": "Triggered when an entity is deleted in Trello"
    },
    {
      "event": "trello.sync_failed",
      "summary": "Triggered when real-time synchronization encounters errors"
    }
  ],
  "rateLimits": {
    "tierStandard": {
      "requestsPerMinute": 120,
      "burst": 30
    },
    "tierEnterprise": {
      "requestsPerMinute": 2400,
      "burst": 500
    }
  }
}
